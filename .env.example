[TEMPLATE]
PORT=4900
NODE_ENV=development
# Web (2274) and admin (2384) dev ports.
# Production needs https://megatech.org,https://www.megatech.org,https://admin.megatech.org.
CORS_ORIGIN=http://localhost:2274,http://localhost:2384
# Production: CORS_ORIGIN=https://megatech.org,https://www.megatech.org,https://admin.megatech.org
# Staging:    CORS_ORIGIN=<the staging frontend origins that call stagingapi.megatech.org>

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/megatech?schema=public"

# --- Deploy bootstrap (runs on `npm start` before the server listens) ---
# DEPLOY_MIGRATE=false   # skip `prisma migrate deploy` on boot (e.g. CI applies migrations)
# DEPLOY_SYNC=false      # skip the additive permission sync on boot
# PRISMA_CLI_TIMEOUT_MS=120000  # max time for the boot-time `prisma migrate deploy`

# --- Admin bootstrap (comma separated emails allowed to self-register as super admins) ---
ADMIN_MAILS="root@megatech.org,admin@megatech.org"

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
INVITE_TTL_HOURS=72

# --- Cookies ---
# Session cookies are httpOnly + SameSite=Lax. Leave both settings UNSET in every
# environment (local, staging, production):
#  - Secure follows the protocol automatically outside production (https → Secure,
#    http://localhost → not Secure); production defaults to Secure.
#  - Without COOKIE_DOMAIN the cookie is host-only on the API host (api.megatech.org,
#    stagingapi.megatech.org, localhost). The frontends still receive it because they are
#    same-site with their API, and staging/production sessions never collide.
#  - COOKIE_DOMAIN is only applied when the API host is inside it (never on localhost).
#    Setting it to megatech.org makes api.* and stagingapi.* share cookie names — avoid.
# COOKIE_SECURE=false        # production only: opt out of Secure (not recommended)
# COOKIE_DOMAIN=             # see above; normally unset

# --- Frontends ---
# ADMIN_WEB_URL=http://localhost:2384   # back-office SPA (used for invite/verify links)
# FRONTEND_WEB_URL=http://localhost:2274 # public web app (welcome + payment-return links)

# --- Google sign-in (GIS ID tokens verified server-side) ---
GOOGLE_CLIENT_ID= # Must match the web app's Google client id

# --- Email REST transport (Mailtrap Send API) ---
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
EMAIL_REST_TIMEOUT_MS=10000

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Megatech <no-reply@megatech.org>"

# Paystack secret key (server-side only; never add to the web frontend)
PAYSTACK_SECRET_KEY=sk_test_replace_me

# --- Storage (Cloudinary signed uploads) ---
# When the Cloudinary vars are empty, the upload-signature endpoint returns 503.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=megatech/media
